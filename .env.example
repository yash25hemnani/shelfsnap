# Required: the server refuses to start without these
GROQ_API_KEY=your-groq-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Keep the quotes and write newlines as literal \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key\n-----END PRIVATE KEY-----\n"

# Book identification and lookup
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# Contact email sent in the User-Agent to Open Library and Wikipedia
OPENLIBRARY_CONTACT=you@example.com
WIKI_CONTACT=you@example.com

# The app's code on GitHub, shown on library pages
REPO_URL=https://github.com/your-user/your-repo

PORT=3000
LOG_LEVEL=info
NODE_ENV=development
